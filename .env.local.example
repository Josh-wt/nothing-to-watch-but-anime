VITE_TEXTURES_BASE_URL=/media
VITE_FILM_INFO_BASE_URL=/json
# Set these to match the actual number of atlas layer files in public/media/{low,mid,high}/.
# With only the sample atlases committed, all are 1 (= 216 cells, tiny grid).
# For a full-screen grid (~52k cells):
#   low:  1 layer  (53,248 capacity)
#   mid: 10 layers (54,000 capacity)
#   high: 241 layers (52,056 capacity — the binding limit)
# If you haven't built compressed atlases, set high to 241 and rely on the
# uncompressed single format below for actual images.
VITE_MEDIA_VERSION_0_LAYERS=1
VITE_MEDIA_VERSION_1_LAYERS=10
VITE_MEDIA_VERSION_2_LAYERS=241
# Enables the uncompressed single-image fallback (public/media/single/{INDEX}.jpg).
# Run scripts/download-posters.mjs to populate it with anime cover images.
VITE_EXPERIMENTAL_MEDIA_VERSION_3_ENABLED=1
VITE_COMPRESS_GLSL=
VITE_ANALYZE_BUNDLE=
