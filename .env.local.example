VITE_TEXTURES_BASE_URL=/media
VITE_FILM_INFO_BASE_URL=/json
# Layer counts — must match the number of atlas files in public/media/{low,mid,high}/.
# These defaults target ~20k cells (matching the ~20k anime entries on AniList):
#   low:  1 layer  (512×104 = 53,248 capacity)
#   mid:  4 layers (90×60×4 = 21,600 capacity)
#   high: 93 layers (18×12×93 = 20,088 capacity) ← binding limit
VITE_MEDIA_VERSION_0_LAYERS=1
VITE_MEDIA_VERSION_1_LAYERS=4
VITE_MEDIA_VERSION_2_LAYERS=93
# Enables the uncompressed single-image fallback (public/media/single/{INDEX}.jpg).
# Run scripts/download-posters.mjs to populate it with anime cover images.
VITE_EXPERIMENTAL_MEDIA_VERSION_3_ENABLED=1
VITE_COMPRESS_GLSL=
VITE_ANALYZE_BUNDLE=
